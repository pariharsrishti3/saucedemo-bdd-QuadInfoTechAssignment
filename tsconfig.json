{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "config/**/*.ts",
    "support/**/*.ts",
    "pages/**/*.ts",
    "steps/**/*.ts"
  ]
}
